# Local development example. Production values belong in /etc/food-rescue.env.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=food-rescue.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://food-rescue.example.com
DJANGO_DATABASE_PATH=/var/www/food-rescue/db.sqlite3
CURRENCY=JPY

# Enable these only after HTTPS is configured correctly in Nginx.
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# Read by scripts/deploy_ec2.sh on EC2.
DEPLOY_HEALTHCHECK_URL=http://127.0.0.1/health/
